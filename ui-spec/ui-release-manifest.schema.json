{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/ui-spec/ui-release-manifest.schema.json",
  "title": "Reader UI Release Manifest",
  "description": "Deterministic raw-byte release boundary consumed by all native hosts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "version",
    "hashAlgorithm",
    "files",
    "groups",
    "abis"
  ],
  "properties": {
    "$schema": {
      "const": "ui-spec/ui-release-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "hashAlgorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/File"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Group"
      }
    },
    "abis": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/Abi"
      }
    }
  },
  "$defs": {
    "SafePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!\\./)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "File": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/SafePath"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fileCount",
        "byteLength",
        "sha256",
        "files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/SafePath"
          }
        }
      }
    },
    "Abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "jsonPointer",
        "entryCount",
        "encoding",
        "sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "component-types",
            "core-commands",
            "core-events",
            "host-requests",
            "motion-ids",
            "ui-events"
          ]
        },
        "source": {
          "enum": [
            "contracts/core-command.schema.json",
            "contracts/core-event.schema.json",
            "contracts/host-request.schema.json",
            "contracts/motion.schema.json",
            "contracts/ui-event.schema.json",
            "contracts/view-state.schema.json"
          ]
        },
        "jsonPointer": {
          "enum": [
            "/$defs/Component/properties/type/enum",
            "/properties/id/enum",
            "/properties/type/enum"
          ]
        },
        "entryCount": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "const": "ordered-json-array-utf8-lf"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "name": { "const": "component-types" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/view-state.schema.json" },
              "jsonPointer": { "const": "/$defs/Component/properties/type/enum" }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "core-commands" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/core-command.schema.json" },
              "jsonPointer": { "const": "/properties/type/enum" }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "core-events" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/core-event.schema.json" },
              "jsonPointer": { "const": "/properties/type/enum" }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "host-requests" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/host-request.schema.json" },
              "jsonPointer": { "const": "/properties/type/enum" }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "motion-ids" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/motion.schema.json" },
              "jsonPointer": { "const": "/properties/id/enum" }
            }
          }
        },
        {
          "if": {
            "properties": { "name": { "const": "ui-events" } },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "source": { "const": "contracts/ui-event.schema.json" },
              "jsonPointer": { "const": "/properties/type/enum" }
            }
          }
        }
      ]
    }
  }
}
