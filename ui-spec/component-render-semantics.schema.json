{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/ui-spec/component-render-semantics.schema.json",
  "title": "Reader UI Component Render Semantics",
  "description": "Declares state ownership and whether canonical children are executable render nodes or anatomy evidence. Runtime values remain in their declared owner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "default", "overrides"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "default": { "$ref": "#/$defs/ComponentSemantics" },
    "overrides": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]+$" },
      "additionalProperties": { "$ref": "#/$defs/ComponentSemantics" }
    }
  },
  "$defs": {
    "ComponentSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateAuthorities", "compositionMode", "notes"],
      "properties": {
        "stateAuthorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["contract", "core", "reader-ui-runtime", "host-store", "host-layout"]
          }
        },
        "compositionMode": {
          "type": "string",
          "enum": ["contract-tree", "host-composite"]
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
