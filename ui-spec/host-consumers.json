{
  "schemaVersion": 2,
  "rolloutPolicy": {
    "hostRequestSchemaVersion": "1.2.0",
    "defaultMode": "shadow",
    "coveredEvents": [
      "book.open",
      "reader.directory.open",
      "reader.directory.close",
      "reader.page.next",
      "reader.page.prev",
      "reader.tts.start",
      "reader.tts.stop",
      "reader.autoPage.start",
      "reader.autoPage.stop",
      "import.start",
      "import.apply",
      "import.cancel",
      "source.switch.open",
      "source.switch.cancel",
      "source.switch.confirm",
      "source.switch.rollback",
      "reader.sourceSwitch.open",
      "reader.sourceSwitch.close",
      "reader.replace.apply",
      "reader.replace.create",
      "reader.replace.validate",
      "rss.refresh",
      "rss.subscription.add",
      "rss.subscription.delete",
      "rss.subscription.edit",
      "rss.entry.open",
      "rss.favorite.add",
      "rss.favorite.remove",
      "sync.run",
      "webdav.config.test",
      "sync.start",
      "sync.progress",
      "sync.complete",
      "sync.conflict",
      "sync.resolve"
    ],
    "pilotEvents": [
      "reader.directory.open",
      "reader.directory.close"
    ],
    "pilotEffectPolicy": "none",
    "effectfulPilotEvents": ["book.open", "reader.tts.start", "reader.tts.stop", "reader.autoPage.start", "reader.autoPage.stop"],
    "effectfulEvents": [
      "book.open",
      "reader.page.next",
      "reader.page.prev",
      "reader.tts.start",
      "reader.tts.stop",
      "reader.autoPage.start",
      "reader.autoPage.stop",
      "import.start",
      "import.apply",
      "import.cancel",
      "source.switch.confirm",
      "source.switch.rollback",
      "reader.replace.apply",
      "reader.replace.create",
      "reader.replace.validate",
      "rss.refresh",
      "rss.subscription.add",
      "rss.subscription.delete",
      "rss.subscription.edit",
      "rss.entry.open",
      "rss.favorite.add",
      "rss.favorite.remove",
      "sync.run",
      "webdav.config.test",
      "sync.start",
      "sync.progress",
      "sync.complete",
      "sync.conflict",
      "sync.resolve"
    ]
  },
  "hosts": [
    {
      "host": "ios",
      "repo": "../Reader-for-iOS",
      "lock": "READER_UI_CONSUMER.json",
      "dependencyChecks": [
        { "file": "iOS/Package.swift", "contains": "ReaderUIRuntime" },
        { "file": "iOS/App/ReaderUIRuntimeShadow.swift", "contains": "GeneratedRuntimeActions" },
        { "file": "iOS/CoreBridge/HostForegroundTimerCapability.swift", "contains": "timer.foreground.arm" },
        { "file": "iOS/CoreBridge/HostForegroundTimerCapability.swift", "contains": "timer.foreground.cancel" },
        { "file": "iOS/CoreBridge/HostAdapter.swift", "contains": "registry.register(HostForegroundTimerCapability())" }
      ]
    },
    {
      "host": "android",
      "repo": "../Reader-for-Android",
      "lock": "READER_UI_CONSUMER.json",
      "dependencyChecks": [
        { "file": "settings.gradle.kts", "contains": "reader-ui-runtime" },
        { "file": "app/build.gradle.kts", "contains": "io.reader.ui:reader-ui-runtime" },
        { "file": "app/src/main/kotlin/com/reader/host/ForegroundTimerCapabilityHandlers.kt", "contains": "timer.foreground.arm" },
        { "file": "app/src/main/kotlin/com/reader/host/ForegroundTimerCapabilityHandlers.kt", "contains": "timer.foreground.cancel" },
        { "file": "app/src/main/kotlin/com/reader/host/HostFacade.kt", "contains": "ForegroundTimerArmHandler(foregroundTimerRegistry)" },
        { "file": "app/src/main/kotlin/com/reader/host/HostFacade.kt", "contains": "ForegroundTimerCancelHandler(foregroundTimerRegistry)" }
      ]
    },
    {
      "host": "harmonyos",
      "repo": "../Reader-for-HarmonyOS",
      "lock": "READER_UI_CONSUMER.json",
      "dependencyChecks": [
        { "file": "build-profile.json5", "contains": "reader_ui_runtime" },
        { "file": "entry/oh-package.json5", "contains": "reader_ui_runtime" },
        { "file": "entry/src/main/ets/host/adapters/ForegroundTimerHostAdapter.ets", "contains": "class ForegroundTimerHostAdapter" },
        { "file": "entry/src/main/ets/bridge/CoreRuntime.ets", "contains": "new ForegroundTimerHostAdapter()" },
        { "file": "entry/src/main/ets/host/HostCapabilityManifest.ets", "contains": "timer.foreground.arm" },
        { "file": "entry/src/main/ets/host/HostCapabilityManifest.ets", "contains": "timer.foreground.cancel" }
      ],
      "packageVersionChecks": [
        { "file": "entry/oh-package-lock.json5", "package": "reader_ui_runtime" }
      ]
    }
  ]
}
