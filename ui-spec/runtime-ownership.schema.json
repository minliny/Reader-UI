{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/ui-spec/runtime-ownership.schema.json",
  "title": "Reader UI Runtime Ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalUiEventCount",
    "expectedImplementedActions",
    "ownershipRules",
    "workflowRules"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "canonicalUiEventCount": { "type": "integer", "minimum": 1 },
    "expectedImplementedActions": { "type": "integer", "minimum": 0 },
    "ownershipRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "coverage", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "events": { "type": "array", "items": { "type": "string" } },
          "prefixes": { "type": "array", "items": { "type": "string" } },
          "fallback": { "type": "boolean" },
          "owner": {
            "type": "string",
            "enum": ["runtime", "platformEphemeral", "split"]
          },
          "coverage": {
            "type": "string",
            "enum": ["planned", "platform"]
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "workflowRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "events": { "type": "array", "items": { "type": "string" } },
          "prefixes": { "type": "array", "items": { "type": "string" } },
          "fallback": { "type": "boolean" },
          "workflow": {
            "type": "string",
            "enum": ["foundation", "W1", "W2", "W3", "W4", "W5", "sync"]
          }
        }
      }
    }
  }
}
