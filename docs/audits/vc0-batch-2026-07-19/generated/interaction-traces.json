  "policy": {
    "motionRegistration": "VC0 仅登记 DOM 中是否存在 data-motion-id（raw motion hint）以及对应 canonical motion id 是否在 IC0 normalized enum 内；不主张动效实际播放。",
    "staticDomEvidence": "before 字段基于 docs/audits/vc0-batch-2026-07-19/generated/browser-structure-observations.json 的 phone 视口观测（headings / controls.sample / demo.routeLayout / rects / scroll）。",
    "dynamicFields": "after / focus / console / stableFinalState 字段需要浏览器自动化（pointer / keyboard / focus / console capture）才能采集；本工作包为只读 Figma/runtime、只写审计证据，未启动浏览器自动化，因此这些字段一律标记为 missing-needs-browser-automation。",
    "derivableUiEvent": "可推导 UiEvent 来自 IC0 motion normalization 表（docs/audits/ic0-2026-07-19/generated/interaction-control-coverage.json 的 motionNormalization.bindings 与 uniqueCanonicalMotionIds）。",
    "nonGoal": "本 JSON 不主张动效已播放、焦点已验证、console 无 error、终态稳定；这些项需要后续 A2/A3 工作包补齐。",
    "aliasEquivalence": "同 renderSha256 的 alias route 不重复 trace；trace 以 familyId 主 routeId 为准。"
  },
  "globalLimitations": [
    "未启动浏览器自动化，无法采集真实 after / focus / console / 稳定终态",
    "本批 12 族均为 motionReduced=1 模式下采集的静态 DOM，未在 motionReduced=0 下做对比",
    "Figma 端 DOM 不可访问，Figma 动效声明仅在 family-manifest.json 层登记，未在 trace 层复述",
    "IC0 仍因 3,815/3,815 controls 缺稳定 join key 未通过；本 trace 不解决 IC0 问题"
  ],
