{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/host-request.schema.json",
  "title": "HostRequest",
  "description": "Reader UI 发送给 Host Adapter 的平台能力请求。1.2.0 起 payload 由 type 判别并默认关闭未知字段；平台 handler 的历史别名不属于 canonical wire。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "http.execute",
        "http.cancel",
        "webview.open",
        "webview.close",
        "webview.evaluate",
        "cookie.get",
        "cookie.set",
        "cookie.clear",
        "file.read",
        "file.write",
        "file.delete",
        "storage.path",
        "persistence.get",
        "persistence.put",
        "credential.get",
        "credential.set",
        "credential.delete",
        "tts.system.start",
        "tts.system.stop",
        "tts.system.pause",
        "tts.system.resume",
        "permission.request",
        "permission.check",
        "background.schedule",
        "background.cancel",
        "timer.foreground.arm",
        "timer.foreground.cancel",
        "notification.show",
        "notification.cancel",
        "share.invoke",
        "clipboard.copy",
        "clipboard.paste",
        "device.vibrate",
        "device.screen.keep-on",
        "device.screen.release",
        "file.select",
        "font.registerFile",
        "font.unregisterFile",
        "clipboard.read",
        "clipboard.write",
        "tts.start",
        "tts.stop",
        "tts.pause",
        "brightness.set",
        "brightness.get",
        "screen.keepAwake",
        "screen.allowSleep",
        "haptics.light",
        "haptics.medium",
        "haptics.heavy",
        "network.status",
        "webdav.connect",
        "webdav.backup",
        "webdav.restore",
        "share.text",
        "share.file",
        "background.task.start",
        "background.task.end"
      ],
      "description": "Host 能力请求类型。新增视为 MINOR，删除或改名视为 MAJOR。"
    },
    "payload": {
      "type": "object",
      "description": "由 type 判别的严格请求 DTO；具体约束见 allOf 与 $defs。"
    },
    "correlationId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "initiator": {
      "type": "string",
      "enum": ["core", "reducer"]
    }
  },
  "allOf": [
    { "$ref": "#/$defs/HttpExecuteCase" },
    { "$ref": "#/$defs/HttpCancelCase" },
    { "$ref": "#/$defs/WebViewOpenCase" },
    { "$ref": "#/$defs/WebViewCloseCase" },
    { "$ref": "#/$defs/WebViewEvaluateCase" },
    { "$ref": "#/$defs/CookieGetCase" },
    { "$ref": "#/$defs/CookieSetCase" },
    { "$ref": "#/$defs/CookieClearCase" },
    { "$ref": "#/$defs/FileReadCase" },
    { "$ref": "#/$defs/FileWriteCase" },
    { "$ref": "#/$defs/FileDeleteCase" },
    { "$ref": "#/$defs/StoragePathCase" },
    { "$ref": "#/$defs/PersistenceGetCase" },
    { "$ref": "#/$defs/PersistencePutCase" },
    { "$ref": "#/$defs/CredentialGetCase" },
    { "$ref": "#/$defs/CredentialSetCase" },
    { "$ref": "#/$defs/CredentialDeleteCase" },
    { "$ref": "#/$defs/TtsSystemStartCase" },
    { "$ref": "#/$defs/TtsSystemStopCase" },
    { "$ref": "#/$defs/TtsSystemPauseCase" },
    { "$ref": "#/$defs/TtsSystemResumeCase" },
    { "$ref": "#/$defs/PermissionRequestCase" },
    { "$ref": "#/$defs/PermissionCheckCase" },
    { "$ref": "#/$defs/BackgroundScheduleCase" },
    { "$ref": "#/$defs/BackgroundCancelCase" },
    { "$ref": "#/$defs/ForegroundTimerArmCase" },
    { "$ref": "#/$defs/ForegroundTimerCancelCase" },
    { "$ref": "#/$defs/NotificationShowCase" },
    { "$ref": "#/$defs/NotificationCancelCase" },
    { "$ref": "#/$defs/ShareInvokeCase" },
    { "$ref": "#/$defs/ClipboardCopyCase" },
    { "$ref": "#/$defs/ClipboardPasteCase" },
    { "$ref": "#/$defs/DeviceVibrateCase" },
    { "$ref": "#/$defs/DeviceScreenKeepOnCase" },
    { "$ref": "#/$defs/DeviceScreenReleaseCase" },
    { "$ref": "#/$defs/FileSelectCase" },
    { "$ref": "#/$defs/FontRegisterFileCase" },
    { "$ref": "#/$defs/FontUnregisterFileCase" },
    { "$ref": "#/$defs/ClipboardReadCase" },
    { "$ref": "#/$defs/ClipboardWriteCase" },
    { "$ref": "#/$defs/TtsStartCase" },
    { "$ref": "#/$defs/TtsStopCase" },
    { "$ref": "#/$defs/TtsPauseCase" },
    { "$ref": "#/$defs/BrightnessSetCase" },
    { "$ref": "#/$defs/BrightnessGetCase" },
    { "$ref": "#/$defs/ScreenKeepAwakeCase" },
    { "$ref": "#/$defs/ScreenAllowSleepCase" },
    { "$ref": "#/$defs/HapticsLightCase" },
    { "$ref": "#/$defs/HapticsMediumCase" },
    { "$ref": "#/$defs/HapticsHeavyCase" },
    { "$ref": "#/$defs/NetworkStatusCase" },
    { "$ref": "#/$defs/WebDavConnectCase" },
    { "$ref": "#/$defs/WebDavBackupCase" },
    { "$ref": "#/$defs/WebDavRestoreCase" },
    { "$ref": "#/$defs/ShareTextCase" },
    { "$ref": "#/$defs/ShareFileCase" },
    { "$ref": "#/$defs/BackgroundTaskStartCase" },
    { "$ref": "#/$defs/BackgroundTaskEndCase" }
  ],
  "$defs": {
    "NonBlankString": { "type": "string", "minLength": 1 },
    "StringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "EmptyPayload": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "HttpExecutePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "method", "headers"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS", "PATCH", "PROPFIND", "MKCOL", "MOVE", "COPY"] },
        "headers": { "$ref": "#/$defs/StringMap" },
        "body": { "type": "string" },
        "charset": { "$ref": "#/$defs/NonBlankString" },
        "followRedirects": { "type": "boolean" },
        "maxRedirects": { "type": "integer", "minimum": 0 }
      }
    },
    "HttpCancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId"],
      "properties": { "requestId": { "$ref": "#/$defs/NonBlankString" } }
    },
    "WebViewOpenPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "profileId": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "WebViewClosePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "profileId": { "$ref": "#/$defs/NonBlankString" } }
    },
    "WebViewEvaluatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "script"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "script": { "$ref": "#/$defs/NonBlankString" },
        "profileId": { "$ref": "#/$defs/NonBlankString" },
        "timeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "CookieRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/NonBlankString" },
        "value": { "type": "string" },
        "domain": { "type": "string" },
        "path": { "type": "string" },
        "secure": { "type": "boolean" },
        "httpOnly": { "type": "boolean" }
      }
    },
    "CookieGetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "name": { "$ref": "#/$defs/NonBlankString" },
        "sessionId": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "CookieSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "cookie"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "cookie": { "$ref": "#/$defs/CookieRecord" },
        "sessionId": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "CookieClearPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "domain": { "$ref": "#/$defs/NonBlankString" },
        "sessionId": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "FileReadPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/NonBlankString" },
        "encoding": { "$ref": "#/$defs/NonBlankString" },
        "byteOffset": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "FileWritePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "$ref": "#/$defs/NonBlankString" },
        "content": { "type": "string" },
        "contentBase64": { "type": "string" },
        "encoding": { "$ref": "#/$defs/NonBlankString" },
        "createDirectories": { "type": "boolean" },
        "append": { "type": "boolean" }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": { "content": { "type": "string" } },
          "required": ["content"],
          "not": {
            "type": "object",
            "properties": { "contentBase64": {} },
            "required": ["contentBase64"]
          }
        },
        {
          "type": "object",
          "properties": { "contentBase64": { "type": "string" } },
          "required": ["contentBase64"],
          "not": {
            "type": "object",
            "properties": { "content": {} },
            "required": ["content"]
          }
        }
      ]
    },
    "PathPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "$ref": "#/$defs/NonBlankString" } }
    },
    "StoragePathPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": { "scope": { "enum": ["cache", "files", "external"] } }
    },
    "PersistenceGetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key"],
      "properties": {
        "namespace": { "$ref": "#/$defs/NonBlankString" },
        "key": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "PersistencePutPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "key", "value", "expectedRevision"],
      "properties": {
        "namespace": { "$ref": "#/$defs/NonBlankString" },
        "key": { "$ref": "#/$defs/NonBlankString" },
        "value": { "type": "string" },
        "expectedRevision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      }
    },
    "CredentialGetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": { "key": { "$ref": "#/$defs/NonBlankString" } }
    },
    "CredentialSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/NonBlankString" },
        "value": { "type": "string" }
      }
    },
    "TtsStartPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/NonBlankString" },
        "voice": { "$ref": "#/$defs/NonBlankString" },
        "language": { "$ref": "#/$defs/NonBlankString" },
        "rate": { "type": "number", "minimum": 0.1, "maximum": 4 },
        "pitch": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "articleId": { "$ref": "#/$defs/NonBlankString" },
        "correlationId": { "$ref": "#/$defs/NonBlankString" },
        "generation": { "type": "integer", "minimum": 0 },
        "sliceIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "ScopePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": { "scope": { "$ref": "#/$defs/NonBlankString" } }
    },
    "BackgroundSchedulePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": {
        "taskId": { "$ref": "#/$defs/NonBlankString" },
        "delayMs": { "type": "integer", "minimum": 0 }
      }
    },
    "TaskIdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId"],
      "properties": { "taskId": { "$ref": "#/$defs/NonBlankString" } }
    },
    "ForegroundTimerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timerId", "correlationId", "delayMs", "generation", "oneShot", "foregroundOnly"],
      "properties": {
        "timerId": { "$ref": "#/$defs/NonBlankString" },
        "correlationId": { "$ref": "#/$defs/NonBlankString" },
        "delayMs": { "type": "integer", "minimum": 250, "maximum": 3600000 },
        "generation": { "type": "integer", "minimum": 0 },
        "oneShot": { "const": true },
        "foregroundOnly": { "const": true }
      }
    },
    "NotificationShowPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "body"],
      "properties": {
        "id": { "$ref": "#/$defs/NonBlankString" },
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "IdPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/NonBlankString" } }
    },
    "ShareInvokePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/NonBlankString" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/NonBlankString" }, "minItems": 1 }
      }
    },
    "TextPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string" } }
    },
    "DeviceVibratePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "durationMs": { "type": "integer", "minimum": 1 } }
    },
    "DeviceScreenKeepOnPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "FileSelectPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mimeTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/NonBlankString" },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "allowsMultiple": { "type": "boolean" }
      }
    },
    "FontRegisterFilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "familyName"],
      "properties": {
        "path": { "type": "string", "pattern": "\\.([tT][tT][fF]|[oO][tT][fF]|[tT][tT][cC])$" },
        "familyName": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "FontUnregisterFilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "familyName"],
      "properties": {
        "path": { "$ref": "#/$defs/NonBlankString" },
        "familyName": { "$ref": "#/$defs/NonBlankString" }
      }
    },
    "BrightnessSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1 } }
    },
    "WebDavCredentialsProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverURL", "username", "password"],
      "properties": {
        "serverURL": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "WebDavConnectPayload": {
      "oneOf": [
        { "$ref": "#/$defs/EmptyPayload" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https?://" } }
        },
        { "$ref": "#/$defs/WebDavCredentialsProperties" }
      ]
    },
    "WebDavBackupPayload": {
      "oneOf": [
        { "$ref": "#/$defs/EmptyPayload" },
        { "$ref": "#/$defs/WebDavCredentialsProperties" }
      ]
    },
    "WebDavRestorePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteURL"],
      "properties": {
        "remoteURL": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "serverURL": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      },
      "dependentRequired": {
        "serverURL": ["username", "password"],
        "username": ["serverURL", "password"],
        "password": ["serverURL", "username"]
      }
    },
    "NamePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "HttpExecuteCase": { "if": { "type": "object", "properties": { "type": { "const": "http.execute" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/HttpExecutePayload" } } } },
    "HttpCancelCase": { "if": { "type": "object", "properties": { "type": { "const": "http.cancel" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/HttpCancelPayload" } } } },
    "WebViewOpenCase": { "if": { "type": "object", "properties": { "type": { "const": "webview.open" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/WebViewOpenPayload" } } } },
    "WebViewCloseCase": { "if": { "type": "object", "properties": { "type": { "const": "webview.close" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/WebViewClosePayload" } } } },
    "WebViewEvaluateCase": { "if": { "type": "object", "properties": { "type": { "const": "webview.evaluate" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/WebViewEvaluatePayload" } } } },
    "CookieGetCase": { "if": { "type": "object", "properties": { "type": { "const": "cookie.get" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CookieGetPayload" } } } },
    "CookieSetCase": { "if": { "type": "object", "properties": { "type": { "const": "cookie.set" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CookieSetPayload" } } } },
    "CookieClearCase": { "if": { "type": "object", "properties": { "type": { "const": "cookie.clear" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CookieClearPayload" } } } },
    "FileReadCase": { "if": { "type": "object", "properties": { "type": { "const": "file.read" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/FileReadPayload" } } } },
    "FileWriteCase": { "if": { "type": "object", "properties": { "type": { "const": "file.write" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/FileWritePayload" } } } },
    "FileDeleteCase": { "if": { "type": "object", "properties": { "type": { "const": "file.delete" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/PathPayload" } } } },
    "StoragePathCase": { "if": { "type": "object", "properties": { "type": { "const": "storage.path" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/StoragePathPayload" } } } },
    "PersistenceGetCase": { "if": { "type": "object", "properties": { "type": { "const": "persistence.get" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/PersistenceGetPayload" } } } },
    "PersistencePutCase": { "if": { "type": "object", "properties": { "type": { "const": "persistence.put" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/PersistencePutPayload" } } } },
    "CredentialGetCase": { "if": { "type": "object", "properties": { "type": { "const": "credential.get" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CredentialGetPayload" } } } },
    "CredentialSetCase": { "if": { "type": "object", "properties": { "type": { "const": "credential.set" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CredentialSetPayload" } } } },
    "CredentialDeleteCase": { "if": { "type": "object", "properties": { "type": { "const": "credential.delete" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/CredentialGetPayload" } } } },
    "TtsSystemStartCase": { "if": { "type": "object", "properties": { "type": { "const": "tts.system.start" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/TtsStartPayload" } } } },
    "TtsSystemStopCase": { "if": { "type": "object", "properties": { "type": { "const": "tts.system.stop" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/EmptyPayload" } } } },
    "TtsSystemPauseCase": { "if": { "type": "object", "properties": { "type": { "const": "tts.system.pause" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/EmptyPayload" } } } },
    "TtsSystemResumeCase": { "if": { "type": "object", "properties": { "type": { "const": "tts.system.resume" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/EmptyPayload" } } } },
    "PermissionRequestCase": { "if": { "type": "object", "properties": { "type": { "const": "permission.request" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/ScopePayload" } } } },
    "PermissionCheckCase": { "if": { "type": "object", "properties": { "type": { "const": "permission.check" } }, "required": ["type"] }, "then": { "type": "object", "properties": { "payload": { "$ref": "#/$defs/ScopePayload" } } } },
