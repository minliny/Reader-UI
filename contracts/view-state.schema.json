{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/view-state.schema.json",
  "title": "ViewState",
  "description": "页面可渲染状态契约。Reducer 产出的 ViewState，Native UI 渲染。来源：各页 01-页面结构稿.md 与 02-组件规格稿.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routeId",
    "pageState",
    "components"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "description": "对应 route.schema.json 的 RouteId。"
    },
    "pageState": {
      "type": "string",
      "enum": [
        "default",
        "loading",
        "empty",
        "error",
        "offline",
        "permission",
        "cover-mode",
        "list-mode",
        "shelf-empty",
        "no-cover",
        "long-title",
        "switching-source-type",
        "source-empty",
        "source-unavailable",
        "network-failed",
        "refreshing",
        "no-subscription",
        "no-unread",
        "local-data-loading",
        "no-backup",
        "permission-missing",
        "topbar-action"
      ]
    },
    "components": {
      "type": "array",
      "description": "页面组件树。顺序按页面结构稿自上而下。",
      "items": {
        "$ref": "#/$defs/Component"
      }
    },
    "context": {
      "type": "object",
      "description": "页面级上下文，如当前书 id、章节 id、来源 id 等。",
      "additionalProperties": true
    }
  },
  "$defs": {
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "AppTopBar",
            "BackTopBar",
            "SearchEntry",
            "SourceTypeSegment",
            "CurrentSourceCard",
            "SourceCategoryChips",
            "DiscoveryContentCard",
            "SourceStatusBar",
            "DiscoverSourceBar",
            "DiscoverEntryRow",
            "DiscoverFilterTrigger",
            "DiscoverListHead",
            "DiscoverBookList",
            "BottomNav",
            "ShelfChipGroup",
            "ContinueReadingCard",
            "RecentUpdateCard",
            "BookshelfShelfSection",
            "ShelfSectionHeader",
            "BookGrid",
            "BookCard",
            "BookListItem",
            "ProgressBar",
            "SubscriptionSummaryCard",
            "FeedStatusChips",
            "FeedSourceChips",
            "RssEntryItem",
            "RssSearchEntry",
            "RssModeRow",
            "RssSourceOverview",
            "RssArticleSection",
            "UnreadIndicator",
            "LocalOverviewCard",
            "QuickEntryGrid",
            "SettingsSection",
            "SettingsListItem",
            "SearchInputBox",
            "ScopeSelector",
            "GroupSelector",
            "SearchHistoryList",
            "SearchResultList",
            "AddToShelfButton",
            "ReadButton",
            "BookCover",
            "BookTitleAuthor",
            "SourceStatus",
            "DirectoryPreview",
            "BookIntro",
            "BookHero",
            "BookSummaryCard",
            "BookChapterList",
            "ConfigEntry",
            "ReadingBackgroundLayer",
            "ReadingTextFlow",
            "ReadingInfoLayer",
            "TapZones",
            "Loading",
            "Empty",
            "Error",
            "ErrorState",
            "Offline",
            "Permission",
            "Toast",
            "Sheet",
            "Dialog",
            "Overlay",
            "List",
            "ListRow",
            "Card",
            "Chip",
            "Button",
            "Toggle",
            "Slider",
            "Stepper",
            "Segment",
            "Dropdown",
            "Input",
            "FormSection",
            "FilterBar",
            "Content",
            "WebView",
            "ReaderBase",
            "ReaderControlSheet",
            "ReaderBottomBar",
            "ReaderDirectoryPanel",
            "ReaderAppearancePanel",
            "ReaderTtsPanel",
            "ReaderSettingsPanel",
            "ReaderSearchPanel",
            "ReaderReplacePanel",
            "ReaderAutoScrollPanel",
            "FloatingBrightness",
            "FloatingQuickActions",
            "FloatingPageControl",
            "NightToast",
            "SourceSwitchResultsPanel",
            "AppShellStructure",
            "MainTabsStructure",
            "SearchHomePage",
            "SearchResultsPage",
            "SearchStatePage",
            "BookTocPreviewPage",
            "BookshelfEmptyPage",
            "SourceManagementPage",
            "SourceDetailPage",
            "SourceImportOptionsPage",
            "SourceDisabledState",
            "SourceSettingsEntryPage",
            "SourceTestResultPage",
            "WebDavConfigPage",
            "SyncSettingsEntryPage",
            "SyncErrorPage",
            "SyncProgressPage",
            "RemoteWebDavBooksPage",
            "RssDetailPage",
            "RssEmptyState",
            "RssErrorState",
            "GlobalStatePage",
            "OfflineStatePage",
            "PermissionRequiredPage",
            "AboutVersionPage",
            "LocalBookImportPage",
            "ReadingSettingsEntryPage",
            "BookMoreMenuPage",
            "BookGroupManagementPage",
            "SourceFormPage",
            "GlobalSettingsPage",
            "BackupSettingsPage",
            "RssSubscriptionManagementPage"
          ],
          "description": "组件类型。来源：各页 02-组件规格稿.md。"
        },
        "id": {
          "type": "string",
          "description": "组件实例 id，用于 focusTarget / 测试定位。"
        },
        "props": {
          "type": "object",
          "additionalProperties": true,
          "description": "组件可渲染属性（文本、列表数据、状态等）。"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        }
      }
    }
  }
}
