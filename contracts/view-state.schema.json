{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/view-state.schema.json",
  "title": "ViewState",
  "description": "页面可渲染状态契约。Reducer 产出的 ViewState，Native UI 渲染。来源：各页 01-页面结构稿.md 与 02-组件规格稿.md。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routeId",
    "pageState",
    "components"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "description": "对应 route.schema.json 的 RouteId。"
    },
    "pageState": {
      "type": "string",
      "enum": [
        "default",
        "loading",
        "empty",
        "error",
        "offline",
        "permission",
        "cover-mode",
        "list-mode",
        "shelf-empty",
        "no-cover",
        "long-title",
        "switching-source-type",
        "source-empty",
        "source-unavailable",
        "network-failed",
        "refreshing",
        "no-subscription",
        "no-unread",
        "local-data-loading",
        "no-backup",
        "permission-missing",
        "topbar-action"
      ]
    },
    "components": {
      "type": "array",
      "description": "页面组件树。顺序按页面结构稿自上而下。",
      "items": {
        "$ref": "#/$defs/Component"
      }
    },
    "context": {
      "type": "object",
      "description": "页面级上下文，如当前书 id、章节 id、来源 id 等。",
      "additionalProperties": true
    },
    "controlLayerLevel": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3"],
      "description": "阅读控制层层级。来源：ARCHITECTURE.md §7。L0 沉浸层；L1 基础控制层；L2 模块/快捷面板；L3 完整控制页。"
    },
    "importPhase": {
      "type": "string",
      "enum": ["idle", "selecting", "input", "parsing", "preview", "conflict", "applying", "result"],
      "description": "W1 导入流程阶段。对应 importState.phase。"
    },
    "readerTocPhase": {
      "type": "string",
      "enum": ["idle", "loading", "offline", "error", "ready"],
      "description": "W2 目录加载阶段。对应 readerTocState。"
    },
    "readerContentPhase": {
      "type": "string",
      "enum": ["idle", "loading", "offline", "error", "ready", "boundary"],
      "description": "W2 正文加载阶段。对应 readerContentState。boundary 表示首章/末章边界。"
    },
    "sourceSwitchPhase": {
      "type": "string",
      "enum": ["idle", "loading", "error", "timeout", "rollback", "preview", "success"],
      "description": "W3 换源流程阶段。对应 sourceSwitchState。"
    },
    "fontManagePhase": {
      "type": "string",
      "enum": ["idle", "importing", "deleting", "fallback", "rename", "enable"],
      "description": "W4 字体管理阶段。对应 fontManagementState。"
    },
    "themeManagePhase": {
      "type": "string",
      "enum": ["idle", "new", "edit", "delete", "duplicate", "setdefault"],
      "description": "W4 主题管理阶段。对应 themeManagementState。"
    },
    "typographyManagePhase": {
      "type": "string",
      "enum": ["idle", "reset", "persist"],
      "description": "W4 排版管理阶段。对应 typographyState.resetConfirm 与排版持久化状态。"
    },
    "replaceRulePhase": {
      "type": "string",
      "enum": ["idle", "create", "update", "delete", "enable", "sort", "validate", "apply", "import", "export", "preview"],
      "description": "W5 替换规则管理阶段。对应 replaceRulesState。"
    }
  },
  "$defs": {
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "AppTopBar",
            "BackTopBar",
            "SearchEntry",
            "SourceTypeSegment",
            "CurrentSourceCard",
            "SourceCategoryChips",
            "DiscoveryContentCard",
            "SourceStatusBar",
            "DiscoverSourceBar",
            "DiscoverEntryRow",
            "DiscoverFilterTrigger",
            "DiscoverListHead",
            "DiscoverBookList",
            "DiscoverStatePage",
            "DiscoverSourceBulkPage",
            "DiscoverSourceLoginPage",
            "DiscoverRuleTestPage",
            "BottomNav",
            "ShelfChipGroup",
            "ContinueReadingCard",
            "RecentUpdateCard",
            "BookshelfShelfSection",
            "ShelfSectionHeader",
            "BookGrid",
            "BookCard",
            "BookListItem",
            "ProgressBar",
            "SubscriptionSummaryCard",
            "FeedStatusChips",
            "FeedSourceChips",
            "RssEntryItem",
            "RssSearchEntry",
            "RssModeRow",
            "RssSourceOverview",
            "RssArticleSection",
            "RssAllPage",
            "RssOriginalPage",
            "RssRefreshingPage",
            "RssOriginalBrowserPage",
            "RssFavoriteGroupsPage",
            "RssSourceGroupsPage",
            "RssSourceImportPage",
            "RssSourceEditPage",
            "UnreadIndicator",
            "LocalOverviewCard",
            "QuickEntryGrid",
            "SettingsHomePage",
            "SettingsGeneralPage",
            "BookshelfSearchSettingsPage",
            "ProgressSyncPage",
            "SettingsSection",
            "SettingsListItem",
            "SearchInputBox",
            "ScopeSelector",
            "GroupSelector",
            "SearchHistoryList",
            "SearchResultList",
            "AddToShelfButton",
            "ReadButton",
            "BookCover",
            "BookTitleAuthor",
            "SourceStatus",
            "DirectoryPreview",
            "BookIntro",
            "BookHero",
            "BookSummaryCard",
            "BookChapterList",
            "ConfigEntry",
            "ReadingBackgroundLayer",
            "ReadingTextFlow",
            "ReadingInfoLayer",
            "TapZones",
            "Loading",
            "Empty",
            "Error",
            "ErrorState",
            "Offline",
            "Permission",
            "Toast",
            "Sheet",
            "Dialog",
            "Overlay",
            "List",
            "ListRow",
            "Card",
            "Chip",
            "Button",
            "Toggle",
            "Slider",
            "Stepper",
            "Segment",
            "Dropdown",
            "Input",
            "FormSection",
            "FilterBar",
            "Content",
            "WebView",
            "ReaderBase",
            "ReaderTopArea",
            "ReaderControlSheet",
            "ReaderBottomBar",
            "ReaderDirectoryPanel",
            "DirectoryPanel",
            "ReaderAppearancePanel",
            "AppearancePanel",
            "ReaderTtsPanel",
            "ReaderSettingsPanel",
            "ReaderFullDirectoryPage",
            "ReaderFullTtsPage",
            "ReaderFullAppearancePage",
            "ReaderFullSettingsPage",
            "ReaderBookCachePage",
            "ReaderDebugInfoPage",
            "ReaderSearchPanel",
            "ReaderReplacePanel",
            "ReplacePanel",
            "ReaderAutoScrollPanel",
            "FloatingBrightness",
            "FloatingQuickActions",
            "FloatingPageControl",
            "NightToast",
            "SourceSwitchResultsPanel",
            "SourceSwitchFlowPage",
            "SourceImportPreviewPage",
            "SourceGroupsPage",
            "SourceDetectPage",
            "SourceDebugPage",
            "SourceDebugRunningPage",
            "SourceDebugResultPage",
            "SourceDebugContentLogPage",
            "SourceCodeViewPage",
            "SourceLogsPage",
            "SourceDeleteConfirmPage",
            "SourceRuleEditPage",
            "SourceBatchPage",
            "AppShellStructure",
            "MainTabsStructure",
            "SearchHomePage",
            "SearchResultsPage",
            "SearchStatePage",
            "BookTocPreviewPage",
            "BookshelfEmptyPage",
            "SourceManagementPage",
            "SourceDetailPage",
            "SourceImportOptionsPage",
            "SourceDisabledState",
            "SourceSettingsEntryPage",
            "SourceTestResultPage",
            "WebDavConfigPage",
            "SyncSettingsEntryPage",
            "SyncBackupPage",
            "SyncErrorPage",
            "SyncProgressPage",
            "RestoreConfirmPage",
            "RestoreProgressPage",
            "RestoreConflictPage",
            "RestoreResultPage",
            "RemoteWebDavBooksPage",
            "RssDetailPage",
            "RssEmptyState",
            "RssErrorState",
            "GlobalStatePage",
            "OfflineStatePage",
            "PermissionRequiredPage",
            "AboutVersionPage",
            "LocalBookImportPage",
            "ReadingSettingsEntryPage",
            "BookMoreMenuPage",
            "BookGroupManagementPage",
            "GroupManagementPage",
            "BookBatchManagementPage",
            "BookDirectoryPage",
            "AboutFeedbackPage",
            "SourceFormPage",
            "GlobalSettingsPage",
            "BackupSettingsPage",
            "RssSubscriptionManagementPage"
          ],
          "description": "组件类型。来源：各页 02-组件规格稿.md。"
        },
        "id": {
          "type": "string",
          "description": "组件实例 id，用于 focusTarget / 测试定位。"
        },
        "props": {
          "type": "object",
          "additionalProperties": true,
          "description": "组件可渲染属性（文本、列表数据、状态等）。"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExplicitBinding"
          },
          "description": "A component with multiple semantic targets may declare executable bindings directly instead of encoding one event in props."
        }
      }
    },
    "ExplicitBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "event", "payload", "trigger"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "trigger": {
          "type": "string",
          "enum": ["tap", "change", "submit", "appear"]
        }
      }
    }
  }
}
