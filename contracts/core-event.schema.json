{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/core-event.schema.json",
  "title": "CoreEvent",
  "description": "Reader-Core-Native 经 thin Host coordinator 返回给 ReaderUIRuntime 的事件契约。Owner: Reader-Core-Native。命名一经发布不得改名。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "book.opened",
        "book.parsed",
        "book.open.failed",
        "book.parse.failed",
        "chapter.listed",
        "chapter.list.failed",
        "content.loaded",
        "content.load.failed",
        "content.search.completed",
        "content.replace.applied",
        "reader.location.resolved",
        "reader.location.resolve.failed",
        "reader.progress.updated",
        "reader.progress.snapshot.ready",
        "source.search.completed",
        "source.search.failed",
        "source.listed",
        "source.list.failed",
        "source.changed",
        "source.change.failed",
        "source.detail.loaded",
        "source.detail.failed",
        "source.detected",
        "source.detect.failed",
        "source.saved",
        "source.save.failed",
        "source.deleted",
        "source.delete.failed",
        "source.debug.completed",
        "source.debug.failed",
        "rss.listed",
        "rss.list.failed",
        "rss.item.loaded",
        "rss.item.load.failed",
        "rss.subscription.listed",
        "rss.subscription.added",
        "rss.subscription.updated",
        "rss.subscription.deleted",
        "rss.subscription.operation.failed",
        "rss.refreshed",
        "rss.refresh.failed",
        "tts.queue.planned",
        "tts.queue.plan.failed",
        "tts.queue.started",
        "tts.queue.paused",
        "tts.queue.resumed",
        "tts.queue.stopped",
        "tts.queue.progress",
        "tts.queue.failed",
        "sync.snapshot.ready",
        "sync.snapshot.failed",
        "sync.pushed",
        "sync.push.failed",
        "sync.pulled",
        "sync.pull.failed",
        "sync.conflict.detected",
        "sync.conflict.resolved",
        "sync.conflict.resolve.failed",
        "bookshelf.listed",
        "bookshelf.list.failed",
        "bookshelf.group.listed",
        "bookshelf.group.created",
        "bookshelf.group.updated",
        "bookshelf.group.deleted",
        "bookshelf.group.operation.failed",
        "bookshelf.book.added",
        "bookshelf.book.removed",
        "bookshelf.book.updated",
        "bookshelf.book.operation.failed",
        "cache.cleared",
        "cache.book.prefetched",
        "cache.book.status.updated",
        "cache.operation.failed",

        "import.parsed",
        "import.persist.completed",
        "import.rollback.completed",
        "import.partial.completed",
        "import.completed",
        "import.failed",

        "source.switch.commit.completed",
        "source.switch.rollback.completed",
        "source.switch.failed",

        "font.register.completed",
        "font.unregister.completed",
        "font.fallback.detected",
        "theme.created",
        "theme.updated",
        "theme.deleted",
        "typography.persist.completed",
        "config.persisted.loaded",
        "config.persisted.saved",

        "replace.applied",
        "replace.persist.completed",
        "replace.validation.completed",
        "replace.undo.completed"
      ],
      "description": "Core 事件类型。命名采用过去式。新增视为 MINOR，删除视为 MAJOR。"
    },
    "payload": {
      "type": "object",
      "description": "事件负载。成功事件含结果数据，失败事件含 error。常用字段：bookId、chapterId、sourceId、rssId、subscriptionId、groupId、chapters、content、location、progress、results、items、queue、snapshot、conflict、conflictId、resolution、error、cached。",
      "additionalProperties": true
    },
    "correlationId": {
      "type": "string",
      "description": "关联对应的 CoreCommand correlationId。"
    },
    "requestId": {
      "type": "string",
      "description": "关联对应的 CoreCommand requestId，用于 cancellation/discard guard。"
    },
    "timestamp": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "事件发生时间（ISO 8601）。"
    }
  }
}
