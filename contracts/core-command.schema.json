{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/core-command.schema.json",
  "title": "CoreCommand",
  "description": "Platform Interaction Reducer 发送给 Reader-Core-Native 的命令契约。Owner: Reader-Core-Native。来源：CONTRACT_FIRST_NATIVE_UI_PLAN.md §5。命名一经发布不得改名。",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "book.open",
        "book.parse",
        "book.close",
        "chapter.list",
        "chapter.load",
        "content.load",
        "content.search",
        "content.replace",
        "reader.location.resolve",
        "reader.progress.update",
        "reader.progress.snapshot",
        "source.search",
        "source.detail",
        "source.detect",
        "source.save",
        "source.delete",
        "source.debug.run",
        "rss.list",
        "rss.item.read",
        "rss.subscription.list",
        "rss.subscription.add",
        "rss.subscription.update",
        "rss.subscription.delete",
        "rss.refresh",
        "tts.queue.plan",
        "tts.queue.start",
        "tts.queue.pause",
        "tts.queue.resume",
        "tts.queue.stop",
        "tts.queue.seek",
        "sync.snapshot",
        "sync.push",
        "sync.pull",
        "sync.conflict.resolve",
        "bookshelf.list",
        "bookshelf.group.list",
        "bookshelf.group.create",
        "bookshelf.group.update",
        "bookshelf.group.delete",
        "bookshelf.book.add",
        "bookshelf.book.remove",
        "bookshelf.book.update",
        "cache.clear",
        "cache.book.prefetch",
        "cache.book.status"
      ],
      "description": "Core 命令类型。新增视为 MINOR，删除视为 MAJOR。"
    },
    "payload": {
      "type": "object",
      "description": "命令负载。常用字段：bookId、chapterId、sourceId、rssId、subscriptionId、groupId、query、keyword、replacement、location、progress、scope、resolution、conflictId、sessionId、intervalMs、voice、offset、limit、sortKey、sortOrder、filterKeys。",
      "additionalProperties": true
    },
    "correlationId": {
      "type": "string",
      "description": "用于关联 CoreEvent 响应。"
    },
    "requestId": {
      "type": "string",
      "description": "唯一请求 id，用于 cancellation/discard guard。"
    }
  }
}
