{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/design-delta.schema.json",
  "title": "ReaderDesignDelta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designDeltaId",
    "status",
    "designRevision",
    "changeLevel",
    "summary",
    "affected",
    "compatibility",
    "hostImpact",
    "validation",
    "release"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "designDeltaId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-[0-9]{8}$"
    },
    "status": { "const": "frozen" },
    "designRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaFileKey", "page", "nodeId", "path", "revision", "capturedAt"],
      "properties": {
        "figmaFileKey": { "type": "string", "minLength": 1 },
        "page": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "changeLevel": { "enum": ["D0", "D1", "D2", "D3", "D4"] },
    "summary": { "type": "string", "minLength": 8 },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "componentTypes",
        "routes",
        "states",
        "motionIds",
        "uiEvents",
        "capabilities",
        "files"
      ],
      "properties": {
        "tokens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "token.schema.json#/properties/name" }
        },
        "componentTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "view-state.schema.json#/$defs/Component/properties/type" }
        },
        "routes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "route.schema.json#/properties/id" }
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["routeId", "state"],
            "properties": {
              "routeId": { "$ref": "route.schema.json#/properties/id" },
              "state": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          }
        },
        "motionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "motion.schema.json#/properties/id" }
        },
        "uiEvents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "ui-event.schema.json#/properties/type" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(core|host|platform)\\.[a-z][a-z0-9.-]*$"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        }
      },
      "anyOf": [
        { "type": "object", "properties": { "tokens": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "componentTypes": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "routes": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "states": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "motionIds": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "uiEvents": { "type": "array", "minItems": 1 } } },
        { "type": "object", "properties": { "capabilities": { "type": "array", "minItems": 1 } } }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseKind", "stableWireIds", "migration", "rollbackArtifactVersion"],
      "properties": {
        "releaseKind": { "enum": ["patch", "minor", "major"] },
        "stableWireIds": { "type": "boolean" },
        "migration": { "enum": ["none", "compat-read-one-version", "required"] },
        "rollbackArtifactVersion": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "stableWireIds": { "const": false } },
            "required": ["stableWireIds"]
          },
          "then": {
            "type": "object",
            "properties": {
              "releaseKind": { "const": "major" },
              "migration": { "enum": ["compat-read-one-version", "required"] }
            }
          }
        }
      ]
    },
    "hostImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "ios", "android", "harmonyos"],
      "properties": {
        "web": { "$ref": "#/$defs/HostImpact" },
        "ios": { "$ref": "#/$defs/HostImpact" },
        "android": { "$ref": "#/$defs/HostImpact" },
        "harmonyos": { "$ref": "#/$defs/HostImpact" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "gates"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "phone-portrait",
              "phone-landscape",
              "tablet-portrait",
              "tablet-landscape"
            ]
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contract",
              "codegen-drift",
              "web-demo",
              "screenshot",
              "motion",
              "reduced-motion",
              "host-build",
              "simulator",
              "device"
            ]
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRequired", "consumerLockRequired", "featureFlag", "rollout"],
      "properties": {
        "artifactRequired": { "const": true },
        "consumerLockRequired": { "const": true },
        "featureFlag": { "type": "boolean" },
        "rollout": { "enum": ["continuous", "batch", "milestone"] }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "HostImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "adapters", "evidence"],
      "properties": {
        "level": { "enum": ["none", "config", "primitive", "layout", "runtime", "capability"] },
        "adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._/-]*$" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["contract", "build", "screenshot", "simulator", "device"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "changeLevel": { "const": "D0" } }, "required": ["changeLevel"] },
      "then": { "type": "object", "properties": { "release": { "type": "object", "properties": { "rollout": { "const": "continuous" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "changeLevel": { "const": "D1" } }, "required": ["changeLevel"] },
      "then": { "type": "object", "properties": { "release": { "type": "object", "properties": { "rollout": { "enum": ["continuous", "batch"] } } } } }
    },
    {
      "if": { "type": "object", "properties": { "changeLevel": { "const": "D2" } }, "required": ["changeLevel"] },
      "then": { "type": "object", "properties": { "release": { "type": "object", "properties": { "rollout": { "const": "batch" } } } } }
    },
    {
      "if": { "type": "object", "properties": { "changeLevel": { "enum": ["D3", "D4"] } }, "required": ["changeLevel"] },
      "then": {
        "type": "object",
        "properties": {
          "release": {
            "type": "object",
            "properties": {
              "featureFlag": { "const": true },
              "rollout": { "const": "milestone" }
            }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "changeLevel": { "const": "D4" } }, "required": ["changeLevel"] },
      "then": { "type": "object", "properties": { "affected": { "type": "object", "properties": { "capabilities": { "type": "array", "minItems": 1 } } } } }
    }
  ]
}
