{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/sync-conflict.schema.json",
  "title": "SyncConflict",
  "description": "同步冲突 model 契约。Owner: Reader-Core-Native。来源：CONTRACT_FIRST_NATIVE_UI_PLAN.md §2、§5 Phase 2 sync conflict model。Reducer 不直接做 WebDAV 冲突策略，只渲染冲突视图并提交用户选择给 Core。",
  "type": "object",
  "additionalProperties": false,
  "required": ["conflictId", "bookId", "type", "local", "remote"],
  "properties": {
    "conflictId": {
      "type": "string",
      "description": "冲突唯一 id。Reducer 用它提交 resolution。"
    },
    "bookId": {
      "type": "string",
      "description": "涉及冲突的书籍 id。"
    },
    "type": {
      "type": "string",
      "enum": ["progress", "bookshelf", "bookmark", "annotation", "source-config"],
      "description": "冲突类型。新增视为 MINOR。"
    },
    "local": {
      "type": "object",
      "description": "本地版本。结构因 type 而异：progress 为 ProgressLocation，bookshelf 为书籍列表，bookmark 为书签列表等。",
      "additionalProperties": true
    },
    "remote": {
      "type": "object",
      "description": "远端版本。结构同 local。",
      "additionalProperties": true
    },
    "localUpdatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "remoteUpdatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "resolution": {
      "type": ["string", "null"],
      "enum": [
        null,
        "keep-local",
        "keep-remote",
        "merge",
        "keep-both",
        "skip"
      ],
      "description": "用户选择的解决方案。null 表示尚未解决。Reducer 提交后 Core 执行 sync.conflict.resolve。"
    },
    "mergeHint": {
      "type": ["object", "null"],
      "description": "Core 提供的合并建议（若 type 支持 auto-merge）。",
      "additionalProperties": true
    },
    "detectedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "冲突检测时间。"
    }
  }
}
