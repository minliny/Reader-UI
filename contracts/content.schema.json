{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/content.schema.json",
  "title": "Content",
  "description": "章节正文 content model 契约。Owner: Reader-Core-Native。来源：CONTRACT_FIRST_NATIVE_UI_PLAN.md §5 Phase 2 content model。统一三端正文渲染语义。",
  "type": "object",
  "additionalProperties": false,
  "required": ["bookId", "chapterId", "blocks"],
  "properties": {
    "bookId": { "type": "string" },
    "chapterId": { "type": "string" },
    "chapterIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "章节序号。"
    },
    "chapterTitle": { "type": ["string", "null"] },
    "blocks": {
      "type": "array",
      "description": "正文内容块数组。三端按 block.type 渲染，不自行解析原始 HTML。",
      "items": { "$ref": "#/$defs/Block" }
    },
    "meta": {
      "type": "object",
      "description": "正文元信息。",
      "additionalProperties": false,
      "properties": {
        "wordCount": { "type": ["integer", "null"], "minimum": 0 },
        "charset": { "type": ["string", "null"] },
        "sourceUrl": { "type": ["string", "null"] },
        "fetchedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "cached": {
      "type": "boolean",
      "default": false,
      "description": "是否来自缓存。"
    }
  },
  "$defs": {
    "Block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "image",
            "blockquote",
            "code",
            "list",
            "divider",
            "blank"
          ],
          "description": "内容块类型。新增视为 MINOR。"
        },
        "text": {
          "type": ["string", "null"],
          "description": "段落/标题/引用/列表项的文本。"
        },
        "level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 6,
          "description": "type=heading 时的标题级别。"
        },
        "url": {
          "type": ["string", "null"],
          "description": "type=image 时的图片 URL。"
        },
        "alt": {
          "type": ["string", "null"],
          "description": "type=image 时的替代文本。"
        },
        "items": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "type=list 时的列表项。"
        },
        "ordered": {
          "type": ["boolean", "null"],
          "description": "type=list 时是否有序。"
        },
        "language": {
          "type": ["string", "null"],
          "description": "type=code 时的语言。"
        }
      }
    }
  }
}
