{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/contracts/appearance.schema.json",
  "title": "ReaderAppearanceSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "defaults", "themes", "fonts", "selects", "steppers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaFileKey", "nodeId", "path", "revision"],
      "properties": {
        "figmaFileKey": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
        "path": { "const": "Reader 2/Full/AppearanceContent" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayThemeId", "nightThemeId", "fontId"],
      "properties": {
        "dayThemeId": { "type": "string", "minLength": 1 },
        "nightThemeId": { "type": "string", "minLength": 1 },
        "fontId": { "type": "string", "minLength": 1 }
      }
    },
    "themes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "scheme", "pairId", "texture", "swatchHex", "backgroundHex", "inkHex"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "scheme": { "enum": ["day", "night"] },
          "pairId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "texture": { "enum": ["plain", "paper"] },
          "swatchHex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "backgroundHex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "inkHex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" }
        }
      }
    },
    "fonts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "familyRole", "webFontStack", "swiftFamily", "arktsValue", "importAction"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z+][a-z0-9+-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "familyRole": { "enum": ["system", "serif", "sans", "mono", "import"] },
          "webFontStack": { "type": "string", "minLength": 1 },
          "swiftFamily": { "type": "string" },
          "arktsValue": { "enum": ["system", "serif", "sans", "kai", "fangsong", "mono", "sourceSerif", "lxgw", "import"] },
          "importAction": { "type": "boolean" }
        }
      }
    },
    "selects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "defaultValue", "options"],
        "properties": {
          "id": { "enum": ["paragraphIndentMode", "textConversion", "pageAnimation", "textAlignment"] },
          "label": { "type": "string", "minLength": 1 },
          "defaultValue": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "steppers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "unit", "defaultValue", "minimum", "maximum", "step", "precision"],
        "properties": {
          "id": { "enum": ["fontSize", "lineHeight", "paragraphGap", "letterSpacing"] },
          "label": { "type": "string", "minLength": 1 },
          "unit": { "enum": ["px", "ratio"] },
          "defaultValue": { "type": "number" },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" },
          "step": { "type": "number", "exclusiveMinimum": 0 },
          "precision": { "type": "integer", "minimum": 0, "maximum": 2 }
        }
      }
    }
  }
}
