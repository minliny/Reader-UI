{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/product-capability.schema.json",
  "title": "Reader Product Capability Delivery Matrix",
  "description": "项目能力到 Figma、Reader-UI、Core/Host 与原生 Host 的机器可读交付映射。该矩阵区分 contract-registered、runtime/browser verified 与 native/device verified，禁止用单层产物冒充全链完成。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "capabilities"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectCharter", "capabilityInventory", "routeSchema", "uiEventSchema", "acceptance"],
      "properties": {
        "projectCharter": { "type": "string", "minLength": 1 },
        "capabilityInventory": { "type": "string", "minLength": 1 },
        "routeSchema": { "type": "string", "minLength": 1 },
        "uiEventSchema": { "type": "string", "minLength": 1 },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "title",
          "scope",
          "capabilityRefs",
          "figma",
          "readerUI",
          "coreHost",
          "nativeHost"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "enum": [
              "foundation",
              "library",
              "remote-content",
              "reader",
              "rss",
              "tts",
              "sync",
              "settings",
              "platform-quality"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "scope": {
            "type": "string",
            "enum": ["current-contract", "product-expansion", "platform-only", "core-only"]
          },
          "capabilityRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "figma": { "$ref": "#/$defs/figmaDelivery" },
          "readerUI": { "$ref": "#/$defs/readerUiDelivery" },
          "coreHost": { "$ref": "#/$defs/coreHostDelivery" },
          "nativeHost": { "$ref": "#/$defs/nativeHostDelivery" }
        }
      }
    }
  },
  "$defs": {
    "deliveryStatus": {
      "type": "string",
      "enum": ["not-planned", "planned", "registered", "candidate", "partial", "verified", "not-required"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "figmaDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "task", "pages", "evidence", "acceptance"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "$ref": "#/$defs/deliveryStatus" },
        "task": { "type": "string", "minLength": 1 },
        "pages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "readerUiDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "routes", "events", "evidence", "acceptance"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "$ref": "#/$defs/deliveryStatus" },
        "routes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "events": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "coreHostDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "responsibilities", "evidence", "acceptance"],
      "properties": {
        "status": { "$ref": "#/$defs/deliveryStatus" },
        "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    },
    "nativeHostDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "responsibilities", "evidence", "acceptance"],
      "properties": {
        "status": { "$ref": "#/$defs/deliveryStatus" },
        "responsibilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/evidence" },
        "acceptance": { "type": "string", "minLength": 1 }
      }
    }
  }
}
