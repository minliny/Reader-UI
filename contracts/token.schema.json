{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/token.schema.json",
  "title": "Token",
  "description": "视觉 token 契约。Token name 一经发布不得改名。来源：frontend-demo-optimized/tokens.css、frontend-demo-optimized/motion-tokens.css、contracts/fixtures/token.fixtures.json。",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "category", "value"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^--fd-ds-[a-zA-Z][a-zA-Z0-9-]*$",
      "description": "Token 名称。必须以 --fd-ds- 开头。允许小写和驼峰。"
    },
    "category": {
      "type": "string",
      "enum": ["color", "font", "type", "spacing", "size", "radius", "shadow", "elevation", "z-index", "text-constraint", "motion-duration", "motion-easing", "icon", "preset"],
      "description": "Token 类别。icon 类别用于把图标语义名纳入 token 治理，value 为图标语义名（与 asset-library/icons.js 的 key 一致），platforms 字段提供三端资源引用模板。preset 类别用于默认阅读主题预设（对应 Demo 中 defaultReaderThemePresets）。"
    },
    "value": {
      "type": "string",
      "description": "Token 值。颜色用 #hex 或 rgba()；字号/间距/尺寸用 Npx；阴影用 box-shadow 表达式；motion-duration 用 Nms；motion-easing 用 CSS easing 函数名；font 用 CSS font-family 栈；icon 用图标语义名（与 asset-library/icons.js 的 key 一致）。"
    },
    "platforms": {
      "type": "object",
      "description": "三端映射建议。平台实际值由 generated 类型承载，本字段仅作映射提示。",
      "additionalProperties": false,
      "properties": {
        "swift": { "type": "string", "description": "SwiftUI 对应（如 Color、CGFloat）" },
        "kotlin": { "type": "string", "description": "Compose 对应（如 Color、Dp）" },
        "arkts": { "type": "string", "description": "ArkUI 对应（如 ResourceColor、number）" }
      }
    },
    "deprecated": { "type": "boolean", "default": false },
    "themePresets": {
      "type": "object",
      "description": "默认阅读主题预设，对应 Demo 中 defaultReaderThemePresets。6 套内置主题，每套包含背景色、文字色、控制层色、纹理、透明度、昼夜配对。来源：frontend-demo-next/render-runtime.js defaultReaderThemePresets。",
      "properties": {
        "day": {
          "type": "object",
          "description": "日间主题。",
          "properties": {
            "backgroundColor": { "type": "string", "description": "背景色，如 #ffffff" },
            "textColor": { "type": "string", "description": "文字色，如 #1f1b17" },
            "controlLayerColor": { "type": "string", "description": "控制层色，如 #fbf2eb" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"], "description": "纹理类型。" },
            "opacity": { "type": "number", "description": "纹理透明度（0-1）。" },
            "dayNightPair": { "type": "string", "description": "昼夜配对主题名，如 night。" }
          }
        },
        "night": {
          "type": "object",
          "description": "夜间主题。",
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "controlLayerColor": { "type": "string" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"] },
            "opacity": { "type": "number" },
            "dayNightPair": { "type": "string" }
          }
        },
        "paper": {
          "type": "object",
          "description": "纸纹主题。",
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "controlLayerColor": { "type": "string" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"] },
            "opacity": { "type": "number" },
            "dayNightPair": { "type": "string" }
          }
        },
        "warm": {
          "type": "object",
          "description": "暖白主题。",
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "controlLayerColor": { "type": "string" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"] },
            "opacity": { "type": "number" },
            "dayNightPair": { "type": "string" }
          }
        },
        "green": {
          "type": "object",
          "description": "青绿主题。",
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "controlLayerColor": { "type": "string" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"] },
            "opacity": { "type": "number" },
            "dayNightPair": { "type": "string" }
          }
        },
        "blue": {
          "type": "object",
          "description": "雾蓝主题。",
          "properties": {
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "controlLayerColor": { "type": "string" },
            "texture": { "type": "string", "enum": ["none", "plain", "paper", "grid"] },
            "opacity": { "type": "number" },
            "dayNightPair": { "type": "string" }
          }
        }
      },
      "required": ["day", "night", "paper", "warm", "green", "blue"]
    },
    "contrastSafetyTokens": {
      "type": "object",
      "description": "D4 对比度安全 token。辅助文字/图标在浅色纸面上的统一可读色及稳定 fallback。来源：frontend-demo-next/tokens.css。",
      "properties": {
        "--fd-text-muted": {
          "type": "string",
          "description": "辅助文字可读色，对比度 ≥ 4.5:1。",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "--fd-icon-muted": {
          "type": "string",
          "description": "辅助图标可读色，对比度 ≥ 4.5:1。",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "--fd-min-text-size": {
          "type": "string",
          "description": "最小可读字号：8-10px 文本统一提升至此值。",
          "pattern": "^[0-9]+px$"
        },
        "--fd-font-zh-fallback": {
          "type": "string",
          "description": "稳定中文 fallback 字体栈：字体缺失时使用。"
        }
      },
      "examples": [
        { "--fd-text-muted": "#514a43" },
        { "--fd-icon-muted": "#514a43" },
        { "--fd-min-text-size": "12px" },
        { "--fd-font-zh-fallback": "\"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans CJK SC\", sans-serif" }
      ]
    }
  }
}
