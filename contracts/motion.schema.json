{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/motion.schema.json",
  "title": "Motion",
  "description": "动效契约。MotionId 一经发布不得改名。来源：frontend-demo/verify/motion/motion-coverage-report.json、frontend-demo/MOTION_CONTRACT.md、frontend-demo/motion-tokens.css。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "durationMs", "easing"],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "app.firstOpen.enter",
        "app.route.push.forward",
        "app.route.pop.backward",
        "app.route.replace",
        "bookshelf.view.switch",
        "button.activate",
        "card.press",
        "card.select",
        "card.route",
        "chip.item.select",
        "destructive.confirm.commit",
        "dropdown.menu.collapse",
        "dropdown.menu.expand",
        "dropdown.option.select",
        "dropdown.trigger.press",
        "feedback.toast.enter",
        "feedback.toast.update",
        "feedback.toast.exit",
        "filter.apply.commit",
        "filter.item.toggle",
        "input.blur",
        "input.clear",
        "input.focus",
        "input.focus-blur",
        "input.submit",
        "listRow.select",
        "motion.interrupt.cancel",
        "motion.interrupt.completeThenReplace",
        "motion.interrupt.redirect",
        "overlay.dialog.enter",
        "overlay.dialog.enter-exit",
        "overlay.dialog.exit",
        "overlay.keyboard.enter-exit",
        "overlay.sheet.enter",
        "overlay.sheet.enter-exit",
        "overlay.sheet.exit",
        "reader.chapter.jump",
        "reader.control.dock.drag",
        "reader.control.dock.longPress",
        "reader.control.dock.rebound",
        "reader.control.dock.release",
        "reader.control.handle.press",
        "reader.control.handle.release",
        "reader.control.hide",
        "reader.entry.actionToImmersive",
        "reader.entry.coverToImmersive",
        "reader.module.switch",
        "reader.page.turn.next-prev",
        "reader.quick.promote",
        "reader.session.autoPage.start",
        "reader.session.capsule.enter",
        "reader.session.capsule.update",
        "reader.session.capsule.exit",
        "reader.session.capsule.switch",
        "reader.session.capsule.control.press-toggle",
        "reader.session.capsule.countdownTick",
        "reader.session.capsule.voiceIcon.active",
        "reader.session.controlSpace.enter",
        "reader.session.controlSpace.update",
        "reader.session.controlSpace.exit",
        "reader.session.tts.start",
        "reader.sourceSwitch.open-close",
        "search.state.replace",
        "segment.item.switch",
        "selection.group.toggle",
        "selection.item.toggle",
        "selection.option.toggle",
        "selection.range.show",
        "selection.toolbar.action",
        "selection.toolbar.exit",
        "slider.drag.start",
        "slider.drag.update",
        "slider.drag.release",
        "state.content.replace",
        "state.loading.inline",
        "stepper.press",
        "stepper.value.change",
        "tab.item.select",
        "tab.switch",
        "toggle.switch",
        "tooling.mode.switch",
        "viewport.orientation.prepare",
        "viewport.orientation.reshape",
        "viewport.orientation.settle"
      ],
      "description": "唯一 MotionId。新增视为 MINOR，删除视为 MAJOR。"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "持续时长（毫秒）。reducedMotion 启用时强制为 0。"
    },
    "easing": {
      "type": "string",
      "enum": ["ease", "ease-in", "ease-out", "ease-in-out", "linear", "none"],
      "description": "缓动函数。来源：MOTION_CONTRACT.md standard=ease, exit=ease-in, enter=ease-out, reshape=ease-in-out。"
    },
    "tokens": {
      "type": "object",
      "description": "对应 motion-tokens.css 的 duration token 引用。",
      "additionalProperties": false,
      "properties": {
        "durationToken": { "type": "string", "description": "如 app.motion.duration.tabSwitch。" },
        "easingToken": { "type": "string", "description": "如 app.motion.easing.standard。" }
      }
    },
    "guardRules": {
      "type": "array",
      "description": "动效守卫规则。来源：MOTION_CONTRACT.md 与 STATE_OWNERSHIP.md §6。",
      "items": { "type": "string" },
      "items_enum_examples": [
        "reducedMotion:forceZeroDuration",
        "dragMustFollowFinger:noEasing",
        "releaseToSnap:afterReleaseOnly",
        "interrupt:cancel|redirect|completeThenReplace",
        "asyncGuard:cancelOnRouteReplace"
      ]
    },
    "deprecated": { "type": "boolean", "default": false }
  }
}
