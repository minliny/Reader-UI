{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/motion.schema.json",
  "title": "Motion",
  "description": "动效契约。MotionId 一经发布不得改名。删除带 `/` 的 MotionId 以避免 codegen 转换 `/` 与 `-` 产生重复 case 名。来源：frontend-demo-optimized/verify/motion/motion-coverage-report.json、frontend-demo-optimized/MOTION_CONTRACT.md、frontend-demo-optimized/motion-tokens.css。",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "MotionId": {
      "$ref": "#/properties/id",
      "description": "MotionId 枚举的具名句柄，供 motion-policy.schema.json 等外部 schema 通过 motion.schema.json#/$defs/MotionId 引用，避免重复维护 95 个枚举值。实际定义见 properties.id。"
    }
  },
  "required": [
    "id",
    "durationMs",
    "easing",
    "implementationKind",
    "interruptPolicy",
    "reducedMotionPolicy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "app.firstOpen.enter",
        "app.route.push.forward",
        "app.route.pop.backward",
        "app.route.replace",
        "bookshelf.view.switch",
        "button.activate",
        "card.press",
        "card.select",
        "card.route",
        "chip.item.select",
        "destructive.confirm.commit",
        "dropdown.menu.collapse",
        "dropdown.menu.expand",
        "dropdown.menu.reposition",
        "dropdown.option.press",
        "dropdown.option.select",
        "dropdown.trigger.press",
        "feedback.toast.enter",
        "feedback.toast.update",
        "feedback.toast.exit",
        "filter.apply.commit",
        "filter.item.toggle",
        "input.blur",
        "input.clear",
        "input.focus",
        "input.focus-blur",
        "input.submit",
        "listRow.select",
        "motion.interrupt.cancel",
        "motion.interrupt.completeThenReplace",
        "motion.interrupt.redirect",
        "overlay.dialog.enter",
        "overlay.dialog.enter-exit",
        "overlay.dialog.exit",
        "overlay.keyboard.enter-exit",
        "overlay.sheet.enter",
        "overlay.sheet.enter-exit",
        "overlay.sheet.exit",
        "reader.chapter.jump",
        "reader.control.dock.drag",
        "reader.control.dock.longPress",
        "reader.control.dock.rebound",
        "reader.control.dock.release",
        "reader.control.handle.drag",
        "reader.control.handle.press",
        "reader.control.handle.release",
        "reader.control.hide",
        "reader.control.show",
        "reader.entry.actionToImmersive",
        "reader.entry.coverToImmersive",
        "reader.module.switch",
        "reader.panel.collapse",
        "reader.panel.expand",
        "reader.page.turn.next-prev",
        "reader.quick.promote",
        "reader.session.autoPage.start",
        "reader.session.capsule.enter",
        "reader.session.capsule.update",
        "reader.session.capsule.exit",
        "reader.session.capsule.switch",
        "reader.session.capsule.control.press-toggle",
        "reader.session.capsule.countdownTick",
        "reader.session.capsule.voiceIcon.active",
        "reader.session.controlSpace.enter",
        "reader.session.controlSpace.update",
        "reader.session.controlSpace.exit",
        "reader.session.tts.start",
        "reader.sourceSwitch.open-close",
        "source.switch.route.push",
        "source.switch.route.pop",
        "source.switch.route.replace",
        "search.state.replace",
        "segment.item.switch",
        "selection.group.toggle",
        "selection.item.toggle",
        "selection.option.toggle",
        "selection.range.show",
        "selection.toolbar.action",
        "selection.toolbar.exit",
        "slider.drag.start",
        "slider.drag.update",
        "slider.drag.release",
        "state.content.replace",
        "state.loading.inline",
        "stepper.press",
        "stepper.value.change",
        "tab.item.press",
        "tab.item.select",
        "tab.item.switch",
        "tab.switch",
        "toggle.switch",
        "tooling.mode.switch",
        "viewport.orientation.prepare",
        "viewport.orientation.reshape",
        "viewport.orientation.settle"
      ],
      "description": "唯一 MotionId。新增视为 MINOR，删除视为 MAJOR。"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "description": "持续时长（毫秒）。reducedMotion 启用时强制为 0。"
    },
    "easing": {
      "type": "string",
      "enum": [
        "ease",
        "ease-in",
        "ease-out",
        "ease-in-out",
        "linear",
        "none"
      ],
      "description": "缓动函数。来源：MOTION_CONTRACT.md standard=ease, exit=ease-in, enter=ease-out, reshape=ease-in-out。"
    },
    "implementationKind": {
      "type": "string",
      "enum": [
        "routeTransition",
        "tabTransition",
        "overlayTransition",
        "stateReplace",
        "readerEntry",
        "readerPageTurn",
        "directManipulation",
        "sessionCapsule",
        "orientationReshape",
        "componentFeedback"
      ],
      "description": "动效实现分类。平台 MotionAdapter 按此选择执行路径。Phase 1 Motion Runtime 新增。"
    },
    "containerRole": {
      "type": "string",
      "enum": [
        "appShell",
        "mainTabShell",
        "readerShell",
        "libraryShell",
        "settingsShell",
        "flowShell",
        "overlayHost",
        "inlineState",
        "listItem",
        "card",
        "readerSurface",
        "sessionCapsule"
      ],
      "description": "动效所属容器角色。用于 MotionPolicy 匹配。Phase 1 Motion Runtime 新增。"
    },
    "operation": {
      "type": "string",
      "enum": [
        "push",
        "pop",
        "replace",
        "tabSwitch",
        "enter",
        "exit",
        "update",
        "dragStart",
        "dragUpdate",
        "dragRelease",
        "reshape",
        "settle"
      ],
      "description": "切换意图。页面只声明 operation，不指定具体 MotionId。Phase 1 Motion Runtime 新增。"
    },
    "visualPattern": {
      "type": "string",
      "enum": [
        "nativeStackForward",
        "nativeStackBackward",
        "fadeReplace",
        "slideSheetUp",
        "scaleDialog",
        "matchedCoverToReader",
        "sharedLayoutMorph",
        "pageTurn",
        "directDrag",
        "capsuleAnchorMove",
        "noMotion"
      ],
      "description": "视觉模式。平台 MotionAdapter 内部映射到原生动画 API。Phase 1 Motion Runtime 新增。"
    },
    "interruptPolicy": {
      "type": "string",
      "enum": [
        "redirect",
        "cancel",
        "completeThenReplace",
        "updateInSameHost"
      ],
      "description": "打断策略（guardRules 中 interrupt:* 的结构化投影）。redirect=新动效接管，cancel=取消当前，completeThenReplace=完成后替换，updateInSameHost=同宿主原地更新。Phase 1 Motion Runtime 新增。"
    },
    "reducedMotionPolicy": {
      "type": "string",
      "enum": [
        "zeroDuration",
        "keepDirectManipulation",
        "noMotion"
      ],
      "description": "reduced-motion 降级策略（guardRules 中 reducedMotion:* / dragMustFollowFinger:* / releaseToSnap:* 的结构化投影）。zeroDuration=时长归零，keepDirectManipulation=手势跟随不可降级，noMotion=无视觉效果。Phase 1 Motion Runtime 新增。"
    },
    "tokens": {
      "type": "object",
      "description": "对应 motion-tokens.css 的 duration token 引用。",
      "additionalProperties": false,
      "properties": {
        "durationToken": {
          "type": "string",
          "description": "如 app.motion.duration.tabSwitch。"
        },
        "easingToken": {
          "type": "string",
          "description": "如 app.motion.easing.standard。"
        }
      }
    },
    "guardRules": {
      "type": "array",
      "description": "动效守卫规则。来源：MOTION_CONTRACT.md 与 STATE_OWNERSHIP.md §6。",
      "items": {
        "type": "string",
        "examples": [
          "reducedMotion:forceZeroDuration",
          "dragMustFollowFinger:noEasing",
          "releaseToSnap:afterReleaseOnly",
          "interrupt:cancel|redirect|completeThenReplace",
          "asyncGuard:cancelOnRouteReplace"
        ]
      }
    },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "触发该动效事务的语义事件。canonical exact family 分批结构化；其余 MotionId 后续逐族补齐。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "允许进入事务的来源状态集合。状态名表达产品语义，不表达 DOM/CSS 实现。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "事务目标状态集合。动态目标使用稳定的语义占位符，例如 quickPanel.target。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interrupt": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "可打断当前事务的语义事件集合；处理方式由 interruptPolicy 决定。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finalState": {
      "type": "string",
      "minLength": 1,
      "description": "正常完成、打断收束或 reduced-motion 降级后必须唯一落到的稳定终态。"
    },
    "cleanup": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "事务结束前必须执行的语义清理动作；不得包含平台或 DOM 私有 API。",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deprecated": {
      "type": "boolean",
      "default": false
    },
    "loop": {
      "type": "object",
      "description": "连续动画配置（循环）。存在时表示动画循环播放。Phase 1 Motion Runtime 扩展。",
      "additionalProperties": false,
      "properties": {
        "forever": {
          "type": "boolean",
          "description": "是否无限循环。true=repeatForever。"
        },
        "autoreverses": {
          "type": "boolean",
          "description": "是否自动反转。true=正反向交替。"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "enum": [
              "app.firstOpen.enter",
              "app.route.push.forward",
              "app.route.pop.backward",
              "app.route.replace",
              "bookshelf.view.switch",
              "button.activate",
              "toggle.switch",
              "chip.item.select",
              "destructive.confirm.commit",
              "filter.apply.commit",
              "filter.item.toggle",
              "slider.drag.start",
              "slider.drag.update",
              "slider.drag.release",
              "stepper.press",
              "stepper.value.change",
              "card.press",
              "card.select",
              "card.route",
              "listRow.select",
              "tab.item.press",
              "tab.item.select",
              "tab.item.switch",
              "tab.switch",
              "segment.item.switch",
              "dropdown.trigger.press",
              "dropdown.menu.expand",
              "dropdown.menu.collapse",
              "dropdown.menu.reposition",
              "dropdown.option.press",
              "dropdown.option.select",
              "reader.entry.coverToImmersive",
              "reader.entry.actionToImmersive",
              "reader.page.turn.next-prev",
              "reader.chapter.jump",
              "reader.control.handle.press",
              "reader.control.handle.drag",
              "reader.control.handle.release",
              "reader.control.dock.longPress",
              "reader.control.dock.drag",
              "reader.control.dock.release",
              "reader.control.dock.rebound",
              "reader.session.tts.start",
              "reader.session.autoPage.start",
              "reader.session.capsule.enter",
              "reader.session.capsule.update",
              "reader.session.capsule.control.press-toggle",
              "reader.session.capsule.countdownTick",
              "reader.session.capsule.voiceIcon.active",
              "reader.session.capsule.switch",
              "reader.session.capsule.exit",
              "viewport.orientation.prepare",
              "viewport.orientation.reshape",
              "viewport.orientation.settle",
              "motion.interrupt.cancel",
              "motion.interrupt.redirect",
              "motion.interrupt.completeThenReplace",
              "source.switch.route.push",
              "source.switch.route.pop",
              "source.switch.route.replace",
              "overlay.sheet.enter",
              "overlay.sheet.exit",
              "overlay.dialog.enter",
              "overlay.dialog.exit",
              "overlay.keyboard.enter-exit",
              "state.loading.inline",
              "feedback.toast.enter",
              "feedback.toast.update",
              "feedback.toast.exit",
              "input.focus",
              "input.blur",
              "input.clear",
              "input.focus-blur",
              "input.submit",
              "search.state.replace",
              "state.content.replace",
              "selection.group.toggle",
              "selection.item.toggle",
              "selection.option.toggle",
              "selection.range.show",
              "selection.toolbar.action",
              "selection.toolbar.exit",
              "tooling.mode.switch",
              "reader.control.show",
              "reader.control.hide",
              "reader.quick.promote",
              "reader.module.switch",
              "reader.panel.expand",
              "reader.panel.collapse"
            ]
          }
        },
        "required": ["id"]
      },
      "then": {
        "properties": {
          "trigger": {},
          "from": {},
          "to": {},
          "interrupt": {},
          "finalState": {},
          "cleanup": {}
        },
        "required": ["trigger", "from", "to", "interrupt", "finalState", "cleanup"]
      }
    }
  ]
}
