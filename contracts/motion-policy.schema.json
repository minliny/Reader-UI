{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/motion-policy.schema.json",
  "title": "MotionPolicy",
  "description": "Motion Resolver 规则表。按 priority 降序匹配，第一条 match 命中即返回 motionId。来源：Phase 2 Motion Runtime。页面只声明 operation/sourceRole/targetRole/containerRole，由 Resolver 解析到 MotionId。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "priority", "match", "motionId"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9-]*$",
      "description": "Policy 规则 id。如 route-push-default。"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "description": "匹配优先级。数值越大越先匹配。同 priority 时按 match 字段数量降序（更具体者先）。"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "description": "匹配条件。省略的字段视为通配。空 match = 全匹配（最低优先级兜底）。",
      "properties": {
        "fromRoute": {
          "type": "string",
          "description": "来源 RouteId。如 bookshelf-list-mode。"
        },
        "toRoute": {
          "type": "string",
          "description": "目标 RouteId。如 reader。"
        },
        "fromShell": {
          "type": "string",
          "enum": ["MainTabShell", "LibraryShell", "ReaderShell", "SettingsShell", "FlowShell"],
          "description": "来源 shell。与 route.schema.json shell enum 对齐。"
        },
        "toShell": {
          "type": "string",
          "enum": ["MainTabShell", "LibraryShell", "ReaderShell", "SettingsShell", "FlowShell"],
          "description": "目标 shell。与 route.schema.json shell enum 对齐。"
        },
        "operation": {
          "type": "string",
          "enum": ["push", "pop", "replace", "tabSwitch", "enter", "exit", "update", "dragStart", "dragUpdate", "dragRelease", "reshape", "settle"],
          "description": "切换意图。与 motion.schema.json operation enum 对齐。"
        },
        "sourceRole": {
          "type": "string",
          "description": "来源语义角色。如 bookCover / actionButton / handle / dock / slider / orientation / page / chapter / content / search / loading / controlLayer / viewMode。自由字符串，便于扩展。"
        },
        "targetRole": {
          "type": "string",
          "description": "目标语义角色。如 sheet / dialog / dropdown / toast。自由字符串，便于扩展。"
        },
        "containerRole": {
          "type": "string",
          "enum": ["appShell", "mainTabShell", "readerShell", "libraryShell", "settingsShell", "flowShell", "overlayHost", "inlineState", "listItem", "card", "readerSurface", "sessionCapsule"],
          "description": "动效所属容器角色。与 motion.schema.json containerRole enum 对齐。"
        },
        "reducedMotion": {
          "type": "boolean",
          "description": "是否启用 reduced-motion。true=仅匹配 reduced-motion 启用场景。"
        }
      }
    },
    "motionId": {
      "type": "string",
      "enum": [
        "app.firstOpen.enter",
        "app.route.push.forward",
        "app.route.pop.backward",
        "app.route.replace",
        "bookshelf.view.switch",
        "button.activate",
        "card.press",
        "card.select",
        "card.route",
        "chip.item.select",
        "destructive.confirm.commit",
        "dropdown.menu.collapse",
        "dropdown.menu.expand",
        "dropdown.option.select",
        "dropdown.trigger.press",
        "feedback.toast.enter",
        "feedback.toast.update",
        "feedback.toast.exit",
        "filter.apply.commit",
        "filter.item.toggle",
        "input.blur",
        "input.clear",
        "input.focus",
        "input.focus-blur",
        "input.submit",
        "listRow.select",
        "motion.interrupt.cancel",
        "motion.interrupt.completeThenReplace",
        "motion.interrupt.redirect",
        "overlay.dialog.enter",
        "overlay.dialog.enter-exit",
        "overlay.dialog.exit",
        "overlay.keyboard.enter-exit",
        "overlay.sheet.enter",
        "overlay.sheet.enter-exit",
        "overlay.sheet.exit",
        "reader.chapter.jump",
        "reader.control.dock.drag",
        "reader.control.dock.longPress",
        "reader.control.dock.rebound",
        "reader.control.dock.release",
        "reader.control.handle.press",
        "reader.control.handle.release",
        "reader.control.hide",
        "reader.entry.actionToImmersive",
        "reader.entry.coverToImmersive",
        "reader.module.switch",
        "reader.page.turn.next-prev",
        "reader.quick.promote",
        "reader.session.autoPage.start",
        "reader.session.capsule.enter",
        "reader.session.capsule.update",
        "reader.session.capsule.exit",
        "reader.session.capsule.switch",
        "reader.session.capsule.control.press-toggle",
        "reader.session.capsule.countdownTick",
        "reader.session.capsule.voiceIcon.active",
        "reader.session.controlSpace.enter",
        "reader.session.controlSpace.update",
        "reader.session.controlSpace.exit",
        "reader.session.tts.start",
        "reader.sourceSwitch.open-close",
        "source.switch.route.push",
        "source.switch.route.pop",
        "source.switch.route.replace",
        "search.state.replace",
        "segment.item.switch",
        "selection.group.toggle",
        "selection.item.toggle",
        "selection.option.toggle",
        "selection.range.show",
        "selection.toolbar.action",
        "selection.toolbar.exit",
        "slider.drag.start",
        "slider.drag.update",
        "slider.drag.release",
        "state.content.replace",
        "state.loading.inline",
        "stepper.press",
        "stepper.value.change",
        "tab.item.select",
        "tab.switch",
        "toggle.switch",
        "tooling.mode.switch",
        "viewport.orientation.prepare",
        "viewport.orientation.reshape",
        "viewport.orientation.settle"
      ],
      "description": "解析结果 MotionId。必须存在于 motion.schema.json id enum。"
    },
    "deprecated": { "type": "boolean", "default": false }
  }
}
