{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/platform-evidence-manifest.schema.json",
  "title": "Reader Platform Slice Evidence Manifest",
  "description": "三端 Slice 0-12 计划登记与执行证据索引。template 只登记 planned；execution 中只有具备测试、artifact 和关闭门禁的 slice 才能标为 passed。",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "manifestKind", "platform", "releaseIdentity", "slices"],
  "properties": {
    "$schema": { "const": "contracts/platform-evidence-manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "manifestKind": { "enum": ["template", "execution"] },
    "platform": { "enum": ["ios", "android", "harmonyos"] },
    "releaseIdentity": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ReleaseIdentity" }
      ]
    },
    "slices": { "$ref": "#/$defs/SliceRegistry" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": { "manifestKind": { "const": "template" } },
        "required": ["manifestKind"]
      },
      "then": {
        "type": "object",
        "properties": {
          "releaseIdentity": { "type": "null" },
          "slices": {
            "type": "object",
            "properties": {
              "slice-0": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-1": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-2": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-3": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-4": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-5": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-6": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-7": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-8": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-9": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-10": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-11": { "$ref": "#/$defs/TemplateSliceEntry" },
              "slice-12": { "$ref": "#/$defs/TemplateSliceEntry" }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "releaseIdentity": { "$ref": "#/$defs/ReleaseIdentity" }
        }
      }
    }
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SourceSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "SafePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "SliceId": {
      "type": "string",
      "enum": [
        "slice-0",
        "slice-1",
        "slice-2",
        "slice-3",
        "slice-4",
        "slice-5",
        "slice-6",
        "slice-7",
        "slice-8",
        "slice-9",
        "slice-10",
        "slice-11",
        "slice-12"
      ]
    },
    "ReleaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "sourceSha", "manifestSha", "readerCoreArtifactSha", "consumerLockSha"],
      "properties": {
        "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sourceSha": { "$ref": "#/$defs/SourceSha" },
        "manifestSha": { "$ref": "#/$defs/Sha256" },
        "readerCoreArtifactSha": { "$ref": "#/$defs/Sha256" },
        "consumerLockSha": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityRefs", "routeIds", "eventTypes", "motionIds", "pageStates"],
      "properties": {
        "capabilityRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "routeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "eventTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "motionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "pageStates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "generated", "coreHost", "nativeBuild", "device"],
      "properties": {
        "contract": { "$ref": "#/$defs/GateStatus" },
        "generated": { "$ref": "#/$defs/GateStatus" },
        "coreHost": { "$ref": "#/$defs/GateStatus" },
        "nativeBuild": { "$ref": "#/$defs/GateStatus" },
        "device": { "$ref": "#/$defs/GateStatus" }
      }
    },
    "GateStatus": {
      "type": "string",
      "enum": ["pending", "passed", "not-required"]
    },
    "TestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "result", "reportPath", "reportSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "command": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "result": { "enum": ["passed", "failed"] },
        "reportPath": { "$ref": "#/$defs/SafePath" },
        "reportSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EvidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "byteLength", "sha256", "targetKind", "capturedAt", "result"],
      "properties": {
        "kind": {
          "enum": [
            "build-report",
            "screenshot",
            "video",
            "device-log",
            "performance",
            "accessibility",
            "corpus",
            "corpus-diff",
            "security-audit",
            "release-lock",
            "rollback"
          ]
        },
        "path": { "$ref": "#/$defs/SafePath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "targetKind": { "enum": ["unit-runner", "simulator", "physical-device", "manual-observation"] },
        "deviceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256,
          "pattern": "^(?!(?:unknown|none|null|mock|fake|test|device|simulator|emulator)$).+$"
        },
        "os": { "type": "string", "minLength": 1, "maxLength": 256 },
        "operator": { "type": "string", "minLength": 1, "maxLength": 256 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "result": { "enum": ["passed", "failed"] }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "targetKind": { "enum": ["physical-device", "manual-observation"] } },
            "required": ["targetKind"]
          },
          "then": {
            "type": "object",
            "required": ["deviceId", "os"],
            "properties": {
              "deviceId": {
                "type": "string",
                "minLength": 4,
                "maxLength": 256,
                "pattern": "^(?!(?:unknown|none|null|mock|fake|test|device|simulator|emulator)$).+$"
              },
              "os": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "targetKind": { "const": "manual-observation" } },
            "required": ["targetKind"]
          },
          "then": {
            "type": "object",
            "required": ["operator"],
            "properties": {
              "operator": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      ]
    },
    "SliceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "status", "dependencies", "coverage", "gates", "tests", "evidence", "blockers", "notes"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": { "enum": ["planned", "in-progress", "blocked", "passed"] },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/SliceId" }
        },
        "coverage": { "$ref": "#/$defs/Coverage" },
        "gates": { "$ref": "#/$defs/Gates" },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestRecord" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRecord" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "notes": { "type": "string", "maxLength": 4096 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "coverage": {
                "type": "object",
                "properties": {
                  "capabilityRefs": { "type": "array", "minItems": 1 }
                }
              },
              "gates": {
                "type": "object",
                "properties": {
                  "contract": { "enum": ["passed", "not-required"] },
                  "generated": { "enum": ["passed", "not-required"] },
                  "coreHost": { "enum": ["passed", "not-required"] },
                  "nativeBuild": { "enum": ["passed", "not-required"] },
                  "device": { "enum": ["passed", "not-required"] }
                }
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/TestRecord" },
                    { "type": "object", "properties": { "result": { "const": "passed" } } }
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/EvidenceRecord" },
                    { "type": "object", "properties": { "result": { "const": "passed" } } }
                  ]
                }
              },
              "blockers": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "TemplateSliceEntry": {
      "allOf": [
        { "$ref": "#/$defs/SliceEntry" },
        {
          "type": "object",
          "properties": {
            "status": { "const": "planned" },
            "tests": { "type": "array", "maxItems": 0 },
            "evidence": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    },
    "SliceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice-0",
        "slice-1",
        "slice-2",
        "slice-3",
        "slice-4",
        "slice-5",
        "slice-6",
        "slice-7",
        "slice-8",
        "slice-9",
        "slice-10",
        "slice-11",
        "slice-12"
      ],
      "properties": {
        "slice-0": { "$ref": "#/$defs/SliceEntry" },
        "slice-1": { "$ref": "#/$defs/SliceEntry" },
        "slice-2": { "$ref": "#/$defs/SliceEntry" },
        "slice-3": { "$ref": "#/$defs/SliceEntry" },
        "slice-4": { "$ref": "#/$defs/SliceEntry" },
        "slice-5": { "$ref": "#/$defs/SliceEntry" },
        "slice-6": { "$ref": "#/$defs/SliceEntry" },
        "slice-7": { "$ref": "#/$defs/SliceEntry" },
        "slice-8": { "$ref": "#/$defs/SliceEntry" },
        "slice-9": { "$ref": "#/$defs/SliceEntry" },
        "slice-10": { "$ref": "#/$defs/SliceEntry" },
        "slice-11": { "$ref": "#/$defs/SliceEntry" },
        "slice-12": { "$ref": "#/$defs/SliceEntry" }
      }
    }
  }
}
