{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/route-reconstruction-quarantine.schema.json",
  "title": "RouteReconstructionQuarantine",
  "description": "源端明确摘除尚未完成 Figma 到原生重建的旧路由消费路径。该清单不修改 Figma binding，也不授予任何视觉或业务能力。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["active", "released"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Entry" }
    }
  },
  "$defs": {
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "routeIds", "reason", "blocksPromotion"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "routeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string", "minLength": 1 },
        "blocksPromotion": { "const": true }
      }
    }
  }
}
