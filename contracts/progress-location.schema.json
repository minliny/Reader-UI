{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader-ui/contracts/progress-location.schema.json",
  "title": "ProgressLocation",
  "description": "阅读进度 canonical location 契约。Owner: Reader-Core-Native。来源：CONTRACT_FIRST_NATIVE_UI_PLAN.md §2、§5。阅读进度以 Core 的 canonical location 为准，平台不能各自发明业务进度模型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["bookId", "chapterIndex", "locator"],
  "properties": {
    "bookId": {
      "type": "string",
      "description": "书籍 id。"
    },
    "chapterIndex": {
      "type": "integer",
      "minimum": 0,
      "description": "章节序号（从 0 开始）。"
    },
    "chapterId": {
      "type": ["string", "null"],
      "description": "章节 id（若 Core 分配）。"
    },
    "locator": {
      "type": "object",
      "description": "章节内 canonical 定位。Core 定义，三端只消费不发明。",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["char-offset", "paragraph-index", "selector", "range"],
          "description": "定位类型。char-offset: 字符偏移；paragraph-index: 段落序号；selector: CSS selector / XPath；range: 范围。"
        },
        "charOffset": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "type=char-offset 时使用。"
        },
        "paragraphIndex": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "type=paragraph-index 时使用。"
        },
        "selector": {
          "type": ["string", "null"],
          "description": "type=selector 时使用。"
        },
        "range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "object", "additionalProperties": true },
            "end": { "type": "object", "additionalProperties": true }
          },
          "description": "type=range 时使用。"
        }
      }
    },
    "progress": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "0.0-1.0 章节内进度。可选，由 locator 派生。"
    },
    "pageIndex": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "分页索引（平台视觉排版派生，不属于 canonical）。"
    },
    "updatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "进度更新时间（ISO 8601）。"
    },
    "source": {
      "type": "string",
      "enum": ["user-read", "chapter-jump", "sync-restore", "search-jump", "tts-follow"],
      "description": "进度产生来源。"
    }
  }
}
